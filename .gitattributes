# manifest_sha256 y dataset_meta.json se calculan sobre los bytes con LF. Con
# core.autocrlf=true (el default de Git para Windows) un checkout los pasaría a CRLF
# y el checksum dejaría de cuadrar.
data/processed/** text eol=lf
docs/*.json text eol=lf
# Los resultados de la F1 se comparan byte a byte con lo que produce `ccls f1`.
resultados/*.json text eol=lf
docs/F*_*.md text eol=lf
